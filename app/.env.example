# Obligatorias
DATABASE_URL=postgres://tita:cambia-esto@localhost:5432/tita
SESSION_SECRET=una-cadena-aleatoria-de-al-menos-40-caracteres
ANTHROPIC_API_KEY=sk-ant-...
# Primer administrador de Tita (solo se usa si aún no existe ninguno; debe cambiar la contraseña al entrar)
ADMIN_EMAIL=admin@titamedia.com
ADMIN_PASSWORD=contrasena-temporal
# Solo para docker-compose
POSTGRES_PASSWORD=cambia-esto
# Opcionales
NODE_ENV=production
TZ=America/Bogota
AI_MODEL=claude-opus-5-5
REFRESH_CRON=17 5 * * *
CRAWLER_DELAY_MS=900
CRAWLER_MAX_PAGES=40
CLASSIFY_BATCH=40
CLASSIFY_MAX_BATCHES=150
CHAT_PER_HOUR=60
DATABASE_SSL=false
# Pon false solo para probar por http sin TLS (no recomendado en producción)
COOKIE_SECURE=true
