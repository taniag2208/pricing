# Obligatorias
DATABASE_URL=postgres://tita:cambia-esto@localhost:5432/tita
SESSION_SECRET=una-cadena-aleatoria-de-al-menos-40-caracteres
ANTHROPIC_API_KEY=sk-ant-...
# Primer administrador de Tita (solo se usa si aún no existe ninguno; debe cambiar la contraseña al entrar)
ADMIN_EMAIL=admin@titamedia.com
ADMIN_PASSWORD=contrasena-temporal
# Solo para docker-compose
POSTGRES_PASSWORD=cambia-esto
# Opcionales
NODE_ENV=production
TZ=America/Bogota
AI_MODEL=claude-opus-5-5
REFRESH_CRON=17 5 * * *
CRAWLER_DELAY_MS=900
CRAWLER_MAX_PAGES=40
CLASSIFY_BATCH=40
CLASSIFY_MAX_BATCHES=150
CHAT_PER_HOUR=60
DATABASE_SSL=false
# Pon false solo para probar por http sin TLS (no recomendado en producción)
COOKIE_SECURE=true

# IA sin costo vía Vercel AI Gateway (créditos gratis mensuales; modelo por defecto google/gemini-2.5-flash)
# AI_PROVIDER=gateway
# AI_GATEWAY_API_KEY=   # solo fuera de Vercel

# --- Motor de lectura ---
# FETCH_MAX_BYTES=8388608          # tamaño máximo por respuesta descargada
# HEADLESS=off                     # desactiva el nivel 3 (navegador) aunque Playwright esté instalado
# BROWSER_WS_ENDPOINT=             # navegador remoto (p. ej. Browserless) para el nivel 3 donde no hay Chromium local
# QUICK_COMP_TIMEOUT_MS=60000      # tiempo máximo por competidor en el análisis rápido
# QUICK_CATS=4                     # categorías del análisis rápido
# AI_SEARCH_MODEL=perplexity/sonar # modelo con búsqueda web (modo gateway)
# --- Seguridad y límites ---
# ALLOWED_ORIGINS=https://pricing.titamedia.com   # orígenes adicionales permitidos para peticiones que cambian datos
# QUICK_AI_TOKENS_DAY=1500000      # tokens de IA por análisis rápido en 24 h
# ORG_AI_TOKENS_DAY=6000000        # tokens de IA por cuenta en 24 h
# ALLOW_PRIVATE_NETWORK=1          # SOLO pruebas locales: permite leer 127.0.0.1 (desactiva la protección SSRF)
# LOG_SILENT=1                     # silencia los logs estructurados (pruebas)
